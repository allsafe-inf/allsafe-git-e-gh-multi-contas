#!/usr/bin/env bash
# Auxiliar de credencial do git para https://github.com: entrega o login e o token da conta
# que atende o dono da URL (ou o login que veio nela). Somente leitura: o git nunca grava
# nem apaga token por aqui.
set -uo pipefail
[[ "${1:-}" == get ]] || exit 0
# shellcheck source=../lib/github-multiconta.sh
. "${GHM_LIB:-$HOME/.local/share/github-multiconta/lib.sh}" || exit 0
ghm_no_host "$0" "$@"
ghm_carregar || exit 0

host="" usuario="" caminho=""
while IFS='=' read -r chave valor; do
  case "$chave" in
    host) host="$valor" ;;
    username) usuario="$valor" ;;
    path) caminho="$valor" ;;
  esac
done
[[ "$host" == github.com ]] || exit 0

# Dono da URL primeiro; depois o login que veio na URL; sem nenhum dos dois, a conta padrão.
if ! ghm_por_dono "${caminho%%/*}"; then
  if [[ -n "$usuario" ]]; then ghm_por_nome "$usuario" || exit 0; else GHM_I=0; fi
fi
ghm_token "${GHM_LOGINS[GHM_I]}" || exit 0
printf 'username=%s\npassword=%s\n' "${GHM_LOGINS[GHM_I]}" "$GHM_T"
